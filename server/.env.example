# Copie este arquivo para ".env" e preencha.

# Porta da API
PORT=3333

# Access Token de TESTE do Mercado Pago (começa com TEST- ou APP_USR-).
# Pegue em https://www.mercadopago.com.br/developers/panel/app -> sua aplicação -> Credenciais de teste.
# Deixe vazio para usar o modo demonstração (pagamento simulado dentro do app).
MP_ACCESS_TOKEN=

# Endereço público da API (opcional). Usado nas páginas de retorno do checkout.
# Com um endereço https (ex.: túnel do ngrok) o Mercado Pago também avisa a API pelo webhook.
# Ex.: PUBLIC_URL=https://abcd-1234.ngrok-free.app
PUBLIC_URL=
